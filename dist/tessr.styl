:root
  // ============================================================
  // DESIGN TOKENS - PRIMITIVES
  // ============================================================
  // Source: Figma Design System Export
  // Last Updated: February 2026
  //
  // The foundational color palette used throughout the app.
  // ============================================================

  // ------------------------------------------------------------
  // GENERAL COLORS
  // ------------------------------------------------------------
  --white: #FFFFFF
  --black: #232323

  // ------------------------------------------------------------
  // GREY
  // ------------------------------------------------------------
  --grey-500: #FAFAFA
  --grey-400: #F3F5F8
  --grey-350: #E0E0E0
  --grey-300: #D7D7D7
  --grey-200: #A6A6A6
  --grey-100: #6B6B6B

  // ------------------------------------------------------------
  // BLUE
  // ------------------------------------------------------------
  --blue-300: #F0F7FF
  --blue-200: #7BCAFF
  --blue-100: #3C9BFA

  // ------------------------------------------------------------
  // RED (Error/Danger)
  // ------------------------------------------------------------
  --red-300: #FEE4E2
  --red-200: #F04438
  --red-100: #D92D20

  // ------------------------------------------------------------
  // GREEN (Success)
  // ------------------------------------------------------------
  --green-300: #CCF3EB
  --green-200: #02C39A
  --green-100: #00A18D

  // ------------------------------------------------------------
  // ORANGE
  // ------------------------------------------------------------
  --orange-300: #FEECDC
  --orange-200: #FFB966
  --orange-100: #F7941D

  // ------------------------------------------------------------
  // STATIC COLORS
  // ------------------------------------------------------------
  --tilemoji-red-150: #F28B82
  --tilemoji-yellow-150: #FDCB6E
  --tilemoji-green-150: #81C784
  --tilemoji-blue-150: #73BFFD
  --tilemoji-purple-150: #BA68C8
  --tilemoji-orange-150: #FF8A65
  --tilemoji-grey-150: #90A4AE
  --tilemoji-brown-150: #A1887F

  // ------------------------------------------------------------
  // TYPOGRAPHY
  // ------------------------------------------------------------
  --font-primary: "Lato", sans-serif

  --font-xs: 9px
  --font-sm: 12px
  --font-base: 14px
  --font-lg: 18px
  --font-xl: 20px
  --font-2xl: 24px
  --font-4xl: 36px
  --font-6xl: 56px

  --font-regular: 400
  --font-bold: 700

  // ------------------------------------------------------------
  // SPACING
  // ------------------------------------------------------------
  --spacing-0: 0px
  --spacing-0-5: 2px
  --spacing-1: 4px
  --spacing-2: 8px
  --spacing-3: 12px
  --spacing-4: 16px
  --spacing-5: 20px
  --spacing-6: 24px
  --spacing-7: 28px
  --spacing-8: 32px
  --spacing-9: 36px
  --spacing-10: 40px
  --spacing-11: 44px
  --spacing-12: 48px
  --spacing-13: 52px
  --spacing-14: 56px
  --spacing-15: 60px
  --spacing-16: 64px
  --spacing-17: 68px
  --spacing-18: 72px
  --spacing-19: 76px
  --spacing-20: 80px

  // ------------------------------------------------------------
  // BORDER RADIUS
  //
  // With a base font size of 14px on the body, 1rem equals 14px
  // and scales accordingly.
  // ------------------------------------------------------------
  --radius-xs: 2px
  --radius-sm: 4px
  --radius-md: 6px
  --radius-lg: 8px
  --radius-xl: 12px
  --radius-2xl: 16px
  --radius-3xl: 24px
  --radius-full: 9999px

  // ------------------------------------------------------------
  // BORDER
  // ------------------------------------------------------------
  --border: 1px
  --border-1-5: 1.5px
  --border-2: 2px
  --border-3: 3px
  --border-4: 4px
  --border-5: 5px
  --border-6: 6px

  // ------------------------------------------------------------
  // Outline
  // ------------------------------------------------------------
  --outline: 1px

  // ------------------------------------------------------------
  // SHADOW
  // ------------------------------------------------------------
  --shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1)

  --text-xs: 9px
  --text-sm: 12px
  --text-base: 14px
  --text-lg: 18px
  --text-xl: 20px
  --text-2xl: 24px
  --text-4xl: 36px
  --text-6xl: 56px

  --font-size: var(--text-base)
font-size: var(--font-size);
color: var(--text-primary);

  --font-regular: 400
  --font-bold: 700

  // ----------------------------------------------------------
  // Spacing (Figma uses 3.5px base unit)
  // TODO: Discuss with design team about standardizing to 4px
  // ----------------------------------------------------------
  --spacing-0: 0px
  --spacing-0-5: 1.75px
  --spacing-1: 3.5px
  --spacing-2: 7px
  --spacing-3: 10.5px
  --spacing-4: 14px
  --spacing-5: 17.5px
  --spacing-6: 21px
  --spacing-7: 24.5px
  --spacing-8: 28px
  --spacing-9: 31.5px
  --spacing-10: 35px
  --spacing-11: 38.5px
  --spacing-12: 42px

  // ----------------------------------------------------------
  // Border Radius (Figma scale)
  // TODO: Confirm with design if 8px should be 7px or 10.5px
  // ----------------------------------------------------------
  --radius-xs: 1.75px
  --radius-sm: 3.5px
  --radius-md: 5.25px
  --radius-lg: 7px
  --radius-xl: 10.5px
  --radius-2xl: 14px
  --radius-3xl: 21px
  --radius-full: 9999px

  // Legacy (keeping until design confirms)
  --card-border-radius: 8px

  // ----------------------------------------------------------
  // Shadows & Effects
  // ----------------------------------------------------------
  --card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)
  --focus-shadow: 0 0 5px 0 rgba(163, 212, 245, 0.9), 0 1px 2px 0 rgba(163, 212, 245, 0.5)

  // ----------------------------------------------------------
  // Component Dimensions
  // ----------------------------------------------------------
  --default-height: 32px
  --button-size: 32px
  --input-width: 200px

  // Layout spacing (using current values until spacing decision)
  --card-gap: 12px
  --card-padding: 16px
  --box-padding: 12px

  // ----------------------------------------------------------
  // Table Specific
  // ----------------------------------------------------------
  --item-table-height: 400px
  --item-table-header-height: 40px
  --ag-value-change-value-highlight-background-color: var(--blue-300)

  // ----------------------------------------------------------
  // Grid
  // ----------------------------------------------------------
  --grid-template: 1fr 1fr
  --g-number: 1
  --g-size: 1fr

  // ----------------------------------------------------------
  // Avatar
  // ----------------------------------------------------------
  --avatar-size: 32px
  --avatar-border: var(--grey-300)

  // ----------------------------------------------------------
  // Badge
  // ----------------------------------------------------------
  --badge-size: 16px
  --badge-color: var(--grey-350)

  // ----------------------------------------------------------
  // Calendar
  // ----------------------------------------------------------
  --arbo-calendar-width: 100%
  --arbo-calendar-outside-color: var(--grey-200)

  // ----------------------------------------------------------
  // Skeleton Loading
  // ----------------------------------------------------------
--background-skeleton: linear-gradient(
  90deg,
  var(--grey-500) 0%,
  var(--grey-500) 20%,
  var(--grey-400) 40%,
  var(--grey-350) 50%,
  var(--grey-400) 60%,
  var(--grey-500) 80%,
  var(--grey-500) 100%
);

  // ----------------------------------------------------------
  // Misc Effects
  // ----------------------------------------------------------
  --multiply-color: rgba(0, 0, 0, 0.05)
  --active-color: var(--primary-color)


  // ==========================================================
  // BUTTON TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Button - Primary
  // ----------------------------------------------------------
  --button-primary-bg-default: var(--blue-100)
  --button-primary-bg-hover: var(--orange-100)
  --button-primary-text: var(--color-white)

  // ----------------------------------------------------------
  // Button - Secondary
  // ----------------------------------------------------------
  --button-secondary-bg-default: var(--grey-400)
  --button-secondary-text-default: var(--blue-100)
  --button-secondary-border-default: var(--color-white)
  --button-secondary-border-thickness: 1px
  --button-secondary-bg-hover: var(--orange-300)
  --button-secondary-text-hover: var(--orange-100)

  // ----------------------------------------------------------
  // Button - Tertiary
  // ----------------------------------------------------------
  --button-tertiary-text-default: var(--blue-100)
  --button-tertiary-text-hover: var(--orange-100)
  --button-tertiary-icon-default: var(--grey-100)
  --button-tertiary-icon-hover: var(--blue-100)

  // ----------------------------------------------------------
  // Button - Disabled (all button types)
  // ----------------------------------------------------------
  --button-disabled-bg: var(--grey-300)
  --button-disabled-text: var(--grey-200)
  --button-disabled-border: var(--grey-400)
  --button-disabled-border-thickness: 1px

  // ----------------------------------------------------------
  // Button - Warning/Danger Primary
  // ----------------------------------------------------------
  --button-danger-bg-default: var(--red-100)
  --button-danger-bg-hover: var(--red-200)
  --button-danger-text: var(--color-white)

  // ----------------------------------------------------------
  // Button - Warning/Danger Secondary
  // ----------------------------------------------------------
  --button-danger-secondary-bg-default: var(--grey-400)
  --button-danger-secondary-border: var(--color-white)
  --button-danger-secondary-bg-hover: var(--red-300)
  --button-danger-secondary-text: var(--red-100)

  // ----------------------------------------------------------
  // Button - Warning/Danger Tertiary
  // ----------------------------------------------------------
  --button-danger-tertiary-text-default: var(--red-100)
  --button-danger-tertiary-text-hover: var(--red-200)

  // ----------------------------------------------------------
  // Button - Selected State (filter applied, etc.)
  // ----------------------------------------------------------
  --button-selected-bg: var(--blue-300)
  --button-selected-border: var(--blue-100)
  --button-selected-text: var(--color-black)
  --button-selected-icon: var(--color-black)

  // ----------------------------------------------------------
  // Button - Clear/Dismiss Icon (in selected buttons)
  // ----------------------------------------------------------
  --button-clear-icon-default: var(--grey-100)
  --button-clear-icon-hover: var(--blue-100)


  // ==========================================================
  // INPUT BOX / INPUT FIELD TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Input - Default State
  // ----------------------------------------------------------
  --input-bg-default: var(--grey-500)
  --input-text-default: var(--color-black)
  --input-text-placeholder: var(--grey-200)
  --input-text-helper: var(--grey-100)
  --input-border-default: var(--grey-400)
  --input-border-thickness-default: 1px

  // ----------------------------------------------------------
  // Input - Hover State
  // ----------------------------------------------------------
  --input-bg-hover: var(--color-white)

  // ----------------------------------------------------------
  // Input - Focus State
  // ----------------------------------------------------------
  --input-bg-focus: var(--color-white)
  --input-border-focus: var(--blue-100)
  --input-border-thickness-focus: 1.5px

  // ----------------------------------------------------------
  // Input - Error State
  // ----------------------------------------------------------
  --input-border-error: var(--red-100)
  --input-error-message: var(--red-100)

  // ----------------------------------------------------------
  // Input - Disabled State
  // ----------------------------------------------------------
  --input-bg-disabled: var(--grey-300)
  --input-text-disabled: var(--grey-200)
  --input-border-thickness-disabled: 1px


  // ==========================================================
  // DROPDOWN / SELECT TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Dropdown Container
  // ----------------------------------------------------------
  --dropdown-bg: var(--color-white)
  --dropdown-text: var(--color-black)
  --dropdown-description: var(--grey-100)
  --dropdown-icon: var(--grey-200)

  // ----------------------------------------------------------
  // Dropdown List Item - Hover State
  // ----------------------------------------------------------
  --dropdown-item-bg-hover: var(--blue-300)

  // ----------------------------------------------------------
  // Dropdown List Item - Focus/Selected State
  // ----------------------------------------------------------
  --dropdown-item-bg-focus: var(--blue-300)
  --dropdown-item-border-focus: var(--blue-100)
  --dropdown-item-border-thickness-focus: 4px

  // ----------------------------------------------------------
  // Dropdown - Remove/Delete Item
  // ----------------------------------------------------------
  --dropdown-remove-bg-hover: var(--red-300)
  --dropdown-remove-icon: var(--red-100)

  // ----------------------------------------------------------
  // Dropdown - Disabled State
  // ----------------------------------------------------------
  --dropdown-bg-disabled: var(--grey-300)
  --dropdown-text-disabled: var(--grey-200)


  // ==========================================================
  // CHIP / TAG TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Chip - Default State
  // ----------------------------------------------------------
  --chip-bg-default: var(--grey-500)
  --chip-text: var(--color-black)
  --chip-border-default: var(--grey-300)
  --chip-border-thickness: 1px

  // ----------------------------------------------------------
  // Chip - Hover State
  // ----------------------------------------------------------
  --chip-bg-hover: var(--blue-300)

  // ----------------------------------------------------------
  // Chip - Error State
  // ----------------------------------------------------------
  --chip-bg-error: var(--red-300)
  --chip-border-error: var(--red-100)


  // ==========================================================
  // TAB TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Tab - Default State
  // ----------------------------------------------------------
  --tab-bg-default: var(--color-white)
  --tab-text-default: var(--grey-100)
  --tab-icon-default: var(--grey-100)
  --tab-border-default: var(--grey-400)
  --tab-border-thickness-default: 1px

  // ----------------------------------------------------------
  // Tab - Hover State
  // ----------------------------------------------------------
  --tab-bg-hover: var(--orange-300)
  --tab-text-hover: var(--orange-100)
  --tab-icon-hover: var(--orange-100)

  // ----------------------------------------------------------
  // Tab - Active/Focus State (selected tab)
  // ----------------------------------------------------------
  --tab-bg-focus: var(--blue-300)
  --tab-text-focus: var(--color-black)
  --tab-icon-focus: var(--color-black)
  --tab-border-focus: var(--blue-100)
  --tab-border-thickness-focus: 3px

  // ----------------------------------------------------------
  // Tab - Disabled State
  // ----------------------------------------------------------
  --tab-bg-disabled: var(--grey-300)
  --tab-text-disabled: var(--grey-200)
  --tab-icon-disabled: var(--grey-200)

  // ----------------------------------------------------------
  // Tab - Error State
  // ----------------------------------------------------------
  --tab-error-message: var(--red-100)
  --tab-bg-error: var(--red-300)
  --tab-text-error: var(--color-black)
  --tab-icon-error: var(--color-black)
  --tab-clear-icon-error-default: var(--grey-100)
  --tab-clear-icon-error-hover: var(--red-200)
  --tab-border-error: var(--red-100)
  --tab-border-thickness-error: 1px


  // ==========================================================
  // CHECKBOX TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Checkbox - Default/Unchecked State
  // ----------------------------------------------------------
  --checkbox-bg-default: var(--color-white)
  --checkbox-border-default: var(--grey-200)
  --checkbox-border-thickness: 1.5px

  // ----------------------------------------------------------
  // Checkbox - Hover State
  // ----------------------------------------------------------
  --checkbox-bg-hover: var(--blue-300)

  // ----------------------------------------------------------
  // Checkbox - Checked State
  // ----------------------------------------------------------
  --checkbox-bg-checked: var(--blue-100)
  --checkbox-border-checked: var(--blue-100)
  --checkbox-icon-checked: var(--color-white)

  // ----------------------------------------------------------
  // Checkbox - Disabled State
  // ----------------------------------------------------------
  --checkbox-bg-disabled: var(--grey-300)
  --checkbox-border-disabled: var(--grey-400)
  --checkbox-text-disabled: var(--grey-200)

  // ----------------------------------------------------------
  // Checkbox - Error State
  // ----------------------------------------------------------
  --checkbox-error-message: var(--red-100)


  // ==========================================================
  // RADIO BUTTON TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Radio - Default/Unselected State
  // ----------------------------------------------------------
  --radio-bg-default: var(--color-white)
  --radio-border-default: var(--grey-200)
  --radio-border-thickness: 1.5px

  // ----------------------------------------------------------
  // Radio - Hover State
  // ----------------------------------------------------------
  --radio-bg-hover: var(--blue-300)

  // ----------------------------------------------------------
  // Radio - Selected State
  // ----------------------------------------------------------
  --radio-border-selected: var(--blue-100)
  --radio-border-thickness-selected: 6px

  // ----------------------------------------------------------
  // Radio - Disabled State
  // ----------------------------------------------------------
  --radio-bg-disabled: var(--grey-300)
  --radio-border-disabled: var(--grey-400)
  --radio-text-disabled: var(--grey-200)

  // ----------------------------------------------------------
  // Radio - Error State
  // ----------------------------------------------------------
  --radio-error-message: var(--red-100)


  // ==========================================================
  // BREADCRUMB TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Breadcrumb - Default (clickable items)
  // ----------------------------------------------------------
  --breadcrumb-text-default: var(--grey-100)
  --breadcrumb-text-hover: var(--blue-100)

  // ----------------------------------------------------------
  // Breadcrumb - Current Page (non-clickable)
  // ----------------------------------------------------------
  --breadcrumb-text-current: var(--grey-200)

  // ----------------------------------------------------------
  // Breadcrumb - Focus State
  // ----------------------------------------------------------
  --breadcrumb-text-focus: var(--color-black)

  // ----------------------------------------------------------
  // Breadcrumb - Navigation Variant (on dark backgrounds)
  // ----------------------------------------------------------
  --breadcrumb-nav-text: var(--color-white)


  // ==========================================================
  // TOOLTIP TOKENS
  // ==========================================================

  --tooltip-bg: var(--grey-100)
  --tooltip-text: var(--color-white)


  // ==========================================================
  // SNACKBAR / TOAST TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Snackbar - Info
  // ----------------------------------------------------------
  --snackbar-info-bg: var(--blue-300)
  --snackbar-info-text: var(--blue-100)

  // ----------------------------------------------------------
  // Snackbar - Success
  // ----------------------------------------------------------
  --snackbar-success-bg: var(--green-300)
  --snackbar-success-text: var(--green-100)

  // ----------------------------------------------------------
  // Snackbar - Danger/Error
  // ----------------------------------------------------------
  --snackbar-danger-bg: var(--red-300)
  --snackbar-danger-text: var(--red-100)

  // ----------------------------------------------------------
  // Snackbar - Warning
  // ----------------------------------------------------------
  --snackbar-warning-bg: var(--orange-300)
  --snackbar-warning-text: var(--orange-100)

  // ----------------------------------------------------------
  // Snackbar - Neutral (default)
  // ----------------------------------------------------------
  --snackbar-neutral-bg: var(--color-white)
  --snackbar-neutral-text: var(--color-black)

  // ----------------------------------------------------------
  // Snackbar - Close Icon
  // ----------------------------------------------------------
  --snackbar-close-icon: var(--grey-200)
  --snackbar-close-icon-neutral: var(--grey-200)


  // ==========================================================
  // GENERAL TOKENS
  // ==========================================================

  // ----------------------------------------------------------
  // Backgrounds
  // ----------------------------------------------------------
  --bg-surface-primary: var(--color-white)
  --bg-surface-secondary: var(--grey-400)
  --bg-surface-archive: var(--grey-350)
  --bg-input: var(--grey-400)

  // ----------------------------------------------------------
  // Text Colors
  // ----------------------------------------------------------
  --text-primary: var(--color-black)
  --text-secondary: var(--grey-100)
  --text-tertiary: var(--color-white)
  --text-inactive: var(--grey-200)

  // ----------------------------------------------------------
  // Borders
  // ----------------------------------------------------------
  --border-default: var(--grey-400)
  --border-selected: var(--blue-100)

  // ----------------------------------------------------------
  // State - Hover
  // ----------------------------------------------------------
  --hover-bg-default: var(--blue-300)
  --hover-bg-danger: var(--red-300)

  // ----------------------------------------------------------
  // State - Success
  // ----------------------------------------------------------
  --success-default: var(--green-200)
  --success-hover: var(--green-100)
  --success-bg: var(--green-300)

  // ----------------------------------------------------------
  // State - Warning
  // ----------------------------------------------------------
  --warning-default: var(--orange-100)
  --warning-bg: var(--orange-300)

  // ----------------------------------------------------------
  // State - Error/Danger
  // ----------------------------------------------------------
  --error-default: var(--red-100)
  --error-hover: var(--red-200)
  --error-bg: var(--red-300)


  // ==========================================================
  // LEGACY COMPATIBILITY
  // ==========================================================
  // These maintain backwards compatibility with existing code
  // Gradually migrate to new token names above
  // ==========================================================

  --primary-color: var(--button-primary-bg-default)
  --primary-color-hover: var(--button-primary-bg-hover)
  --danger-color: var(--error-default)
  --danger-color-hover: var(--error-hover)
  --success-color: var(--success-default)
  --warning-color: var(--warning-default)
  --disabled-color: var(--button-disabled-bg)
  --disable-text-color: var(--button-disabled-text)
  --background-color: var(--bg-surface-primary)
  --bg-secondary: var(--bg-surface-secondary)
  --bg-inactive-color: var(--bg-surface-archive)
  --text-color: var(--text-primary)
  --text-inactive-color: var(--text-inactive)
  --border-color: var(--border-default)
  --selected-border-color: var(--border-selected)
  --hover-color: var(--hover-bg-default)
  --hover-color-danger: var(--hover-bg-danger)
  --hover-selected-color: var(--button-selected-bg)